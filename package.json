{
  "name": "lightsplitters-web",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build lightsplitters-web && ng build couple-site",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:site": "ng build lightsplitters-web",
    "build:couple": "ng build couple-site",
    "start:couple": "ng serve couple-site --port 4300",
    "start:album": "ng serve couple-site --configuration album --port 4301",
    "photos": "bash scripts/sync-photos.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "^8.3.3"
  }
}
