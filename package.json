{
  "name": "lightsplitters-web",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build lightsplitters-web && ng build couple-site",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:site": "ng build lightsplitters-web",
    "build:couple": "ng build couple-site",
    "start:couple": "ng serve couple-site --port 4300",
    "start:album": "ng serve couple-site --configuration album --port 4301",
    "photos": "bash scripts/sync-photos.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vite": "^8.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  }
}
